# Copy this to .env and fill in your values. Never commit .env.

# EPC API (api.get-energy-performance-data.communities.gov.uk)
EPC_BEARER_TOKEN=your_epc_bearer_token_here

# UKPN Open Data API (was grid headroom in site_context; the UKPN dataset has
# been retired, so this is currently non-functional and can be left blank)
UKPN_API_KEY=your_ukpn_api_key_here

# Gemini judge via Vertex AI (no API key needed)
# Create a service account with the "Vertex AI User" role and download a JSON key.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# Generation endpoint (required). Any OpenAI-compatible /chat/completions host.
# There is no local-weights path: all generation is hosted.
#
# The configured target is Llama 3.3 70B on Vertex AI Model-as-a-Service
# (us-central1 only, needs one-time Model Garden enablement on the "API service"
# card). Leave LLM_API_KEY unset for Vertex and auth falls back to Google ADC or
# the service-account key above.
LLM_API_BASE=https://us-central1-aiplatform.googleapis.com/v1beta1/projects/your-gcp-project-id/locations/us-central1/endpoints/openapi

# Optional overrides. LLM_MODEL defaults to MODEL_NAME in generate_rfq.py
# (meta/llama-3.3-70b-instruct-maas), which is the model of record for the thesis.
# Set LLM_API_KEY for a static-bearer provider such as Together, Groq, Fireworks
# or OpenRouter, e.g. LLM_API_BASE=https://api.together.xyz/v1.
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=6

# Demo mode — set to 1 to skip the LLM entirely and use canned responses
# DEMO_MOCK_LLM=1
