EPC_BEARER_TOKEN=xxx
UKPN_API_KEY=xxx
# --- Gemini judge via Vertex AI (no API key, no gcloud CLI) ---
# With GEMINI_API_KEY removed and GOOGLE_CLOUD_PROJECT set, the client routes
# through Vertex automatically (no GEMINI_USE_VERTEX flag needed).
GOOGLE_CLOUD_PROJECT=xxx
GOOGLE_CLOUD_LOCATION=xxx
GEMINI_MODEL=gemini-3.5-flash-lite
# Path to the service-account JSON key you download from the console (Step 4):
GOOGLE_APPLICATION_CREDENTIALS=xxx

# --- Generation backend (Renbee demo) ---
# Deliberately left on "local" so the thesis evaluation keeps using the local
# Llama 3.2 3B. For the demo, override it just for that one process:
#   LLM_BACKEND=cloud uvicorn app:app --port 8000
# No API key line: Vertex authenticates with the service-account key above.
LLM_BACKEND=xxx
LLM_API_BASE=xxx
LLM_MODEL=meta/llama-3.3-70b-instruct-maas